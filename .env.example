# PostgreSQL Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=cardinaltalent
DB_PASSWORD=your_postgres_password_here
DB_PORT=5432

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret (CHANGE IN PRODUCTION! Use a long random string)
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# Google Sign-In. Use the same Client ID for backend verification and frontend button.
# Create OAuth 2.0 Web application credentials at https://console.cloud.google.com/apis/credentials
# For localhost/staging use one OAuth client; for production use another (different Client IDs).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Vite exposes env vars prefixed with VITE_ to the client (required for the Sign in with Google button):
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client URL
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Email Configuration (password reset & transactional email via AWS SES)
EMAIL_FROM=cardin@cardinaltalent.ai
# AWS SES credentials (use either AWS_* or SES_* from production .env)
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your-ses-access-key
AWS_SECRET_KEY=your-ses-secret-key
# Alternative names (also supported): SES_REGION, SES_ACCESS_KEY, SES_SECRET_KEY
